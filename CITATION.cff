    family-names: Jeong
    alias: VerifiedIdiot
repository-code: "https://github.com/VerifiedIdiot/korean-handwriting-rec"
url: "https://huggingface.co/Rebeccaaaaaaaa/korean-handwriting-rec"
license: Apache-2.0
version: 1.0.0
date-released: 2026-10-18
keywords:
  - ocr
  - korean
  - handwriting-recognition
  - handwritten-text-recognition
  - hangul
  - pp-ocrv5
  - paddleocr
  - onnx
